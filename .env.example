# ============================================================================
# Flask Windows Authentication + LDAP Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# LDAP/Active Directory Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Update these values with your corporate LDAP/AD settings
#
# 📖 Need help finding your LDAP server?
#    See: docs/LDAP_SERVER_DETECTION.md for detection instructions
#
# Quick detection (PowerShell):
#   $d = [System.DirectoryServices.ActiveDirectory.Domain]::GetCurrentDomain()
#   Write-Host "LDAP_SERVER=ldap://$($d.PdcRoleOwner.Name)"
#   Write-Host "LDAP_BASE_DN=DC=$($d.Name -replace '\.',',DC=')"

# LDAP Server URL (use your domain controller)
# Examples:
#   - Single DC: ldap://dc01.company.com
#   - Domain name: ldap://company.com (DNS round-robin)
#   - Multiple DCs: ldap://dc01.company.com,ldap://dc02.company.com
#   - Secure LDAP: ldaps://dc01.company.com:636
#   - Global Catalog: ldap://dc01.company.com:3268
LDAP_SERVER=ldap://dc01.company.com

# Base DN for LDAP searches (your domain in DN format)
# This is where LDAP will search for users
# Examples:
#   - Single domain: DC=company,DC=com
#   - Subdomain: DC=subdomain,DC=company,DC=com
#   - Multi-level: DC=dept,DC=region,DC=company,DC=com
LDAP_BASE_DN=DC=company,DC=com

# User DN (where users are stored) - OPTIONAL
# Usually not needed as search uses SUBTREE scope
# Example: CN=Users,DC=company,DC=com
LDAP_USER_DN=CN=Users,DC=company,DC=com

# ----------------------------------------------------------------------------
# LDAP Connection Pool Configuration (OPTIONAL)
# ----------------------------------------------------------------------------
# Connection pooling improves performance by reusing LDAP connections

# Number of connections in the pool
# Recommended: 10 for small deployments, 20-50 for large deployments
# Default: 10
LDAP_POOL_SIZE=10

# Connection lifetime in seconds (how long to keep connections alive)
# Recommended: 300 (5 minutes) - balance between reuse and freshness
# Default: 300
LDAP_POOL_KEEPALIVE=300

# ----------------------------------------------------------------------------
# Flask Application Configuration (OPTIONAL)
# ----------------------------------------------------------------------------

# Debug mode - Set to 'true' ONLY for development, NEVER in production
# Production: False (default)
# Development: true
FLASK_DEBUG=False

# Host to bind to
# 0.0.0.0 = all interfaces (default)
# 127.0.0.1 = localhost only
FLASK_HOST=0.0.0.0

# Port to listen on
# Default: 5000
FLASK_PORT=5000

# ----------------------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ----------------------------------------------------------------------------

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Production: INFO or WARNING
# Development: DEBUG
# Default: INFO
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Kerberos Configuration (Docker/Kubernetes only)
# ----------------------------------------------------------------------------
# Only needed for Docker/Kubernetes deployments
# Not needed for Windows IIS deployments

# Path to keytab file (inside container)
# Default: /app/keytab
# KRB5_KTNAME=/app/keytab

# Kerberos configuration file (inside container)
# Default: /etc/krb5.conf
# KRB5_CONFIG=/etc/krb5.conf

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Copy this file to .env and update with your actual values:
#    cp .env.example .env
#
# 2. Never commit .env to version control (protected by .gitignore)
#
# 3. LDAP_SERVER and LDAP_BASE_DN are REQUIRED
#    - See docs/LDAP_SERVER_DETECTION.md for help finding these values
#
# 4. All other settings have sensible defaults
#
# 5. For production, always set FLASK_DEBUG=False
#
# 6. Connection pooling is enabled by default with LDAP_POOL_SIZE=10
#
# 7. For Docker/Kubernetes deployments:
#    - Create keytab using deploy/create-keytab-simple.ps1
#    - See deploy/KEYTAB_GUIDE.md for instructions
#
# 8. For Windows IIS deployments:
#    - No keytab needed
#    - Windows Authentication handles Kerberos automatically
